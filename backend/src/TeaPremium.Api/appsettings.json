{
  "ApiMetadata": {
    "Name": "TeaPremium API",
    "Version": "v1"
  },
  "MediaStorage": {
    "MaximumFileSizeBytes": 10485760,
    "UploadUrlLifetimeMinutes": 10,
    "InspectionPrefixBytes": 262144
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
