# Copy OUTSIDE the repository with mode 0600; do not commit real credentials.
PGHOST=postgres
PGPORT=5432
PGDATABASE=teapremium
PGUSER=backup_reader
PGPASSWORD=
# Public key only. Keep the private age identity offline, outside the backup server.
AGE_RECIPIENT=
BACKUP_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_EC2_METADATA_DISABLED=true
