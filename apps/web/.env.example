# Ten lam viec; thay bang ten thuong hieu da duoc xac nhan truoc Production.
NEXT_PUBLIC_SITE_NAME=TeaPremium
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DESCRIPTION=Không gian giới thiệu trà cụ cao cấp, kiến thức thưởng trà và kết nối tư vấn.
API_BASE_URL=http://localhost:5080/api/v1
# Public API từ trình duyệt; cấu hình URL thật ở Production, có thể dùng đường dẫn cùng origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080/api/v1
# Mac dinh noindex. Chi bat sau khi co domain HTTPS va noi dung that.
SITE_INDEXABLE=false
# De trong khi chua co thong tin da duoc shop xac nhan. Khong dung du lieu mau.
SITE_ABOUT=
SITE_ADDRESS=
SITE_HOTLINE=
SITE_ZALO_URL=
SITE_FACEBOOK_URL=
# Public CDN origin khop voi backend; khong phai R2 API endpoint hay secret.
R2_PUBLIC_BASE_URL=
# Chỉ điền Measurement ID thật (G-...), script tải sau khi khách đồng ý.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

